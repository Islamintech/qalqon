[Unit]
Description=ScamGuard — Telegram anti-scam moderation bot
Documentation=https://github.com/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=scamguard
Group=scamguard
WorkingDirectory=/opt/scamguard
# python-dotenv reads .env from WorkingDirectory, so credentials never appear
# in this unit file (which is world-readable) or in `systemctl show` output.
ExecStart=/opt/scamguard/.venv/bin/python main.py

# Restart on ANY exit, including a clean one. A moderation bot that has stopped
# is invisible: the groups look protected while nobody is watching them.
Restart=always
RestartSec=10

# ...but do not spin forever on a config error. Five failures inside a minute
# means it cannot start at all, and hammering Telegram will not fix that. The
# unit enters `failed`, which is visible in `systemctl status`, and the missing
# heartbeat is what actually tells the operator.
StartLimitIntervalSec=60
StartLimitBurst=5

# Conflict (a second instance polling the same token) exits deliberately via
# stop_running(); the restart is harmless because the other instance keeps the
# token and this one will keep exiting — visible as a restart loop.

# Logs go to the journal: `journalctl -u scamguard -f`. Rotation and retention
# are journald's job, configured centrally in /etc/systemd/journald.conf.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=scamguard

# Hardening. The bot needs outbound network, its own directory, and nothing
# else — a compromised dependency should not be able to read /etc or /home.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# The only writable path: the SQLite database, the .session file and .env live
# here. Everything else on disk is read-only to this process.
ReadWritePaths=/opt/scamguard

[Install]
WantedBy=multi-user.target
